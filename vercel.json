{
"version": 2,
"buildCommand": "npm run build",
"outputDirectory": "build",

"rewrites": [
{
"source": "/displayrates",
"destination": "https://tv-rate-display.vercel.app"
},
{
"source": "/displayrates/:path*",
"destination": "https://tv-rate-display.vercel.app/:path*"
}
],

"functions": {
"api/**/*.js": {
"runtime": "nodejs20.x"
}
},

"crons": [
{
"path": "/api/rates/save",
"schedule": "0 * * * *"
},
{
"path": "/api/rates/sync-gold-rates",
"schedule": "*/30 * * * *"
}
]
}
