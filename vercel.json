{
"version": 2,
"buildCommand": "npm run build",
"outputDirectory": "build",

"routes": [
{
"src": "^/displayrates$",
"dest": "https://tv-rate-display.vercel.app"
},
{
"src": "^/displayrates/(.*)",
"dest": "https://tv-rate-display.vercel.app/$1"
},

```
{ "handle": "filesystem" },

{
  "src": "/(.*)",
  "dest": "/index.html"
}
```

],

"functions": {
"api/**/*.js": {
"runtime": "nodejs20.x"
}
},

"crons": [
{
"path": "/api/rates/save",
"schedule": "0 * * * *"
},
{
"path": "/api/rates/sync-gold-rates",
"schedule": "*/30 * * * *"
}
]
}
